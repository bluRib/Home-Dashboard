# Home Assistant connection settings.
#
# Copy this file to .env in the same folder, fill in HA_TOKEN, then run:
#   python tools/gen_config.py
#
# That writes app/js/config.js, which is the file the browser actually loads.
# Both .env and app/js/config.js are gitignored because they hold the token.

# Hostname or IP of your Home Assistant box. No scheme, no port.
HA_HOST=homeassistant.local

# Port Home Assistant listens on. 8123 is the default.
HA_PORT=8123

# true if you reach HA over https (uses wss), false for plain http (uses ws).
HA_SSL=false

# Long lived access token. Create it in Home Assistant under
# Profile, Security tab, "Long-lived access tokens".
HA_TOKEN=

# Optional. Seconds between reconnect attempts after the socket drops.
# The client backs off up to 30s on repeated failures.
HA_RECONNECT=2

# Optional. Pirate Weather API key, used by one panel on the Climate screen,
# the next 60 minutes of rain. Home Assistant's Pirate Weather integration
# does not expose the minutely block, so that panel calls the API directly.
# Free key from https://pirateweather.net/ . Everything else works without it.
PW_KEY=
