# Secrets. The Home Assistant token lives in app/.env and is copied into the
# two generated config files by tools/gen_config.py. None of them may ever be
# committed. The .example file is the safe template.
app/.env
app/js/config.js
ha-kaiyami/config.local.js
!app/.env.example

# Private configuration copied in from other systems. Holds API keys and
# passwords (Homepage's services.yaml, and anything else like it), so the whole
# folder is ignored rather than individual files, which is one fewer thing to
# get wrong when the next file lands here.
private/

# A stray copy at the repo root, in case one is ever dropped there again
# before it reaches private/. It arrived there once already.
/homepage.yml
/services.yaml

# Dependencies and the esbuild binary, restored by
# ha-kaiyami/tools/install-deps.py
ha-kaiyami/node_modules/

# Python
__pycache__/
*.pyc

# OS cruft
Thumbs.db
desktop.ini
.DS_Store
